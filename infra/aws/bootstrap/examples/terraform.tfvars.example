# Copy this file to terraform.tfvars in infra/aws/bootstrap/ and adjust.
# Do not commit terraform.tfvars.
#
# Run once per AWS account before infra/aws/stack.
# After apply, copy `backend_hcl_hint` into the stack backend config
# (see ../stack/examples/backend.hcl.example).

aws_region = "us-east-1"

# Must be globally unique. Recommended pattern (matches wasctl naming):
#   wolfram-was-tfstate-<env>-<account_id>
state_bucket_name = "wolfram-was-tfstate-prod-123456789012"

# Still created by bootstrap for legacy / break-glass; the stack backend
# example uses S3 native locking (use_lockfile = true) instead.
lock_table_name = "wolfram-was-tfstate-lock-prod"
